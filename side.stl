// ===============================
// Isogrid side panel (STL-ready)
// ===============================

// Panel parameters
panel_w   = 230;   // mm
panel_h   = 160;   // mm
thickness = 3;     // mm

// Isogrid parameters
s      = 20;                     // nominal spacing
t      = 2.5;                    // rib thickness
h_tri  = s * sqrt(3) / 2;        // vertical pitch

// How many cells to cover the panel
nx = ceil(panel_w / s) + 2;
ny = ceil(panel_h / h_tri) + 2;

// 3D part
linear_extrude(height = thickness)
    isogrid_panel();

// -------------------------------
// 2D isogrid panel
// -------------------------------
module isogrid_panel() {
    difference() {
        // Solid rectangle first
        square([panel_w, panel_h], center = false);

        // Subtract tri-hex pockets
        for (iy = -1; iy <= ny; iy++) {
            for (ix = -1; ix <= nx; ix++) {

                // Offset every other row for proper tri-hex tiling
                x0 = ix * s + (iy % 2 == 0 ? 0 : s/2);
                y0 = iy * h_tri;

                // Only process pockets that intersect the panel area
                if (x0 > -s && x0 < panel_w + s &&
                    y0 > -h_tri && y0 < panel_h + h_tri) {

                    // Hex pocket at node
                    hex_pocket(x0, y0, s, t);

                    // Upward triangle pocket
                    tri_pocket_up(x0, y0 + h_tri/2, s, t);

                    // Downward triangle pocket
                    tri_pocket_down(x0, y0 - h_tri/2, s, t);
                }
            }
        }
    }
}

// -------------------------------
// Pocket primitives
// -------------------------------
module hex_pocket(cx, cy, s, t) {
    r = s/2 - t/2;
    polygon(points = [
        [cx + r,              cy],
        [cx + r/2,            cy + r*sqrt(3)/2],
        [cx - r/2,           